# Settings for docker-compose.prod.yml. Copy to .env.prod (never commit it) and fill in:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# The backend containers read this whole file as Laravel's environment; database, Redis and
# Reverb hosts inside the stack are set by the compose file.

# --- Public addresses (what browsers use; served through your TLS reverse proxy) ---
# Laravel: the API (APP_URL/api/v1), the admin panel (/super-admin) and uploaded files.
APP_URL=https://api.example.com
# The Next.js app.
FRONTEND_URL=https://app.example.com
# Live websockets (Reverb).
REVERB_PUBLIC_HOST=ws.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# --- Ports the stack publishes on this machine (the reverse proxy forwards to these) ---
# 127.0.0.1 keeps them off the network when the proxy runs on the same machine.
PUBLISH_IP=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
REVERB_PORT=8080

# --- Laravel ---
APP_NAME=MindSpear
# Generate one: docker run --rm php:8.4-cli php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# The frontend's origin(s), comma separated.
CORS_ALLOWED_ORIGINS=https://app.example.com
# Hostnames (no scheme) allowed to use cookie sessions with the API.
SANCTUM_STATEFUL_DOMAINS=app.example.com
# Shared parent domain of the app and the API, so the session cookie reaches both.
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
BCRYPT_ROUNDS=12
# stderr: logs go to `docker compose logs`. Use "daily" for files in the storage volume.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Created (or kept) on every start when both are set: the /super-admin login.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Database (PostgreSQL, created on first start) ---
DB_DATABASE=mindspear
DB_USERNAME=mindspear
DB_PASSWORD=

# --- Redis (cache, sessions, queues) ---
REDIS_PASSWORD=

# --- Reverb (live sessions). Pick your own: e.g. openssl rand -hex 16 ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Hostnames allowed to open websockets (the app's), comma separated.
REVERB_ALLOWED_ORIGINS=app.example.com
REVERB_SCALING_ENABLED=false

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Sign in with Google / Microsoft (optional; the callbacks are pages of the app) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://app.example.com/auth/microsoft/callback

# --- AWS S3 (optional; uploads use the local storage volume unless configured) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- AI question generation (ai-server/, its own service on port 8001) ---
# Passed to the ai-server container; LARAVEL_API_URL and CORS are set in docker-compose.prod.yml.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Image tag for the built images (mindspear-backend, mindspear-backend-web, mindspear-frontend).
IMAGE_TAG=latest

          },
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=\"$db\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"$db\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"$db\"}[5m])))",
          "legendFormat": "",

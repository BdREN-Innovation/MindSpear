# =================================================================================================
# Settings for monitoring/docker-compose.yml. Each value below is also the built-in default, which
# fits the dev stack (docker-compose.yml), so on a developer machine this file is optional.
#
#   cp monitoring/.env.example monitoring/.env    # git-ignored: never commit it
#   chmod 600 monitoring/.env                     # then set the values marked "Prod:"
#   docker compose -f monitoring/docker-compose.yml up -d
#
# Generate secrets:  openssl rand -hex 32
# Use hex values for secrets: a "$" or "#" in a value is misread when this file is loaded.
# =================================================================================================

# "dev" or "prod": the env= label on every metric.
# Prod: prod
MONITORING_ENV=dev

# The app's Docker network, which the database exporters join.
# Prod: mindspear-prod_mindspear
APP_NETWORK=mindspear_mindspear

# --- Grafana ---------------------------------------------------------------------------------------
# Prod: keep 127.0.0.1; nginx serves it at https://dev.mindspear.app/grafana/.
# Dev: 0.0.0.0 to open it from another machine on the network.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3200
GRAFANA_ADMIN_USER=admin
# Prod: a hex secret. Applied on Grafana's first start only (an empty grafana-data volume).
GRAFANA_ADMIN_PASSWORD=admin
# Prod: GRAFANA_DOMAIN=dev.mindspear.app
#       GRAFANA_ROOT_URL=https://%(domain)s/grafana/
#       GRAFANA_SERVE_FROM_SUB_PATH=true
#       GRAFANA_COOKIE_SECURE=true
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3200/
GRAFANA_SERVE_FROM_SUB_PATH=false
GRAFANA_COOKIE_SECURE=false

# --- Prometheus ------------------------------------------------------------------------------------
# It has no login: keep it on 127.0.0.1 (k6 on this machine pushes to it).
PROM_BIND=127.0.0.1
PROM_PORT=9090
# History kept: whichever limit is reached first.
PROM_RETENTION=15d
PROM_RETENTION_SIZE=5GB

# --- PostgreSQL (as seen from the app network) ----------------------------------------------------
# Prod: DB_USERNAME / DB_PASSWORD / DB_DATABASE from backend/.env.prod, or better a read-only role
# (monitoring/README.md, "A read-only database role").
POSTGRES_HOST=postgres
POSTGRES_EXPORTER_USER=myuser
POSTGRES_EXPORTER_PASSWORD=mypassword
POSTGRES_EXPORTER_DB=mindspear

# --- Redis (as seen from the app network) ---------------------------------------------------------
# Prod: REDIS_PASSWORD from backend/.env.prod. Dev Redis has none.
REDIS_HOST=redis
REDIS_PASSWORD=
# Laravel queue keys: <REDIS_PREFIX>queues:<queue name>, in database 0. The prefix follows APP_NAME
# unless REDIS_PREFIX is set in the backend env; monitoring/README.md says how to confirm it.
REDIS_QUEUE_KEYS=db0=mindspear_database_queues:default,db0=mindspear_database_queues:fungames,db0=mindspear_database_queues:documents
REDIS_QUEUE_KEY_PATTERNS=db0=mindspear_database_queues:*:delayed,db0=mindspear_database_queues:*:reserved

# =================================================================================================
# Production settings for docker-compose.prod.yml: the same variables, in the same order, as
# backend/.env, with production values. Laravel, PostgreSQL and Redis read this file (env_file:).
# This template is committed, so it must stay free of secrets.
#
#   cp backend/.env.prod.example backend/.env.prod   # git-ignored: never commit it
#   chmod 600 backend/.env.prod                      # then fill in the values marked "Required"
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Generate:  openssl rand -hex 32
# Use hex values for secrets: a "$" or "#" in a value is misread when this file is loaded.
#
# To apply a change, run the docker compose command above again. Compose recreates only the
# services whose settings changed.
# =================================================================================================

APP_NAME=MindSpear
APP_ENV=production
# Required. Encrypts sessions and data. Changing it later logs everyone out and makes encrypted
# data unreadable. Generate: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Keep false here: true shows error details, including secrets, to visitors.
APP_DEBUG=false
# The public address: the API (APP_URL/api/v1), /super-admin and links to uploads.
# Also set in docker-compose.prod.yml (frontend build args): change both, then add --build.
APP_URL=https://dev.mindspear.app
APP_TIMEZONE=UTC
# An absolute path, unlike backend/.env: php-fpm runs from another folder than `php artisan`.
VIEW_COMPILED_PATH=/app/storage/framework/views
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en

# The Next.js app. Used in links, such as those in emails.
FRONTEND_URL=https://dev.mindspear.app
# Which sites may call the API from a browser. The site's own origin, comma separated.
CORS_ALLOWED_ORIGINS=https://dev.mindspear.app
# Leave empty: the frontend signs in with bearer tokens. Listing the domain here turns on CSRF
# checks for its API calls, and they then fail with 419.
SANCTUM_STATEFUL_DOMAINS=
# null: the admin panel's session cookie is sent only to this exact hostname.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEST_V2_DEFAULT_ENABLED=true
QUIZ_V2_DEFAULT_ENABLED=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Only used by `php artisan serve`; production runs php-fpm. Kept to match backend/.env.
PHP_CLI_SERVER_WORKERS=4

# stderr: logs go to `docker compose logs`.
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
# debug | info | warning | error. Use debug only while chasing a problem.
LOG_LEVEL=warning
LOG_DAYS=14

DB_CONNECTION=pgsql
# The service name in docker-compose.prod.yml. Leave it.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mindspear
DB_USERNAME=mindspear
# Required. Generate: openssl rand -hex 32
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb
REDIS_CLIENT=predis
# The service name in docker-compose.prod.yml. Leave it.
REDIS_HOST=redis
REDIS_PORT=6379
# Required. Generate: openssl rand -hex 32
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# Required, all three. Generate: openssl rand -hex 16
# The key is public (every browser receives it) and is also set in docker-compose.prod.yml
# (frontend build args): if you change it, change both and add --build. The secret stays private.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# How Laravel reaches Reverb inside docker, not through nginx. Leave these.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# The site's hostname, without https://. Websockets from any other site are refused.
REVERB_ALLOWED_ORIGINS=dev.mindspear.app
# true only when running several Reverb containers.
REVERB_SCALING_ENABLED=false

# Verification and password-reset emails. smtp sends real mail; log sends nothing, so use it only
# until you have SMTP details.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@mindspear.app"
MAIL_FROM_NAME="${APP_NAME}"

# Optional. Uploads stay in the docker "storage" volume unless a disk is pointed at S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: sign in with Google. Register this redirect URI in Google's console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dev.mindspear.app/auth/google/callback

# Optional: sign in with Microsoft. Register this redirect URI in Microsoft's console.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://dev.mindspear.app/auth/microsoft/callback

# Required: the /super-admin login. Created on start if this email doesn't exist yet. Changing the
# password here later has no effect on an account that already exists.
# Generate the password: openssl rand -hex 16
SUPER_ADMIN_EMAIL=admin@mindspear.app
SUPER_ADMIN_PASSWORD=

# The PostgreSQL container creates its database on the very first start from the DB_* values above.
# Don't edit these three. Changing DB_PASSWORD later does NOT change it in the existing database:
# run ALTER USER inside the postgres container as well.
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_DATABASE}

NEXT_PUBLIC_API_BASE_URL=

# AI generation server (ai-server/): an absolute URL (its CORS_ORIGINS must allow this site)
# or a path such as /ai-api that next.config.ts rewrites to AI_PROXY_URL (same origin, no CORS).
NEXT_PUBLIC_AI_API_URL=http://localhost:8001
# AI_PROXY_URL=http://localhost:8001

# Laravel Reverb
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# APP ENV
NEXT_PUBLIC_APP_URL=https://mindspear.app

# Fun Games: set to 1 to run against an in-browser mock instead of the Laravel API.
NEXT_PUBLIC_FUN_GAMES_MOCK=0

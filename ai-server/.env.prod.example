# =================================================================================================
# Production settings for the ai-server container (docker-compose.prod.yml, env_file:): the same
# variables as ai-server/.env, with production values. This template is committed, so it must stay
# free of secrets.
#
#   cp ai-server/.env.prod.example ai-server/.env.prod   # git-ignored: never commit it
#   chmod 600 ai-server/.env.prod                        # then set OPENROUTER_API_KEY
#   docker compose -f docker-compose.prod.yml up -d      # applies a change
# =================================================================================================

# --- Server ---
APP_ENV=production
LOG_LEVEL=info
# Browser origins allowed to call this server. Empty: the browser reaches it through /ai-api on
# the site's own origin (nginx), so no CORS is needed.
CORS_ORIGINS=

# --- Sign-in check (the Laravel API; the user's bearer token is verified against it) ---
# The backend-web container in docker-compose.prod.yml. Leave it.
LARAVEL_API_URL=http://backend-web/api/v1
# Keep false: true skips the token check, so anyone could use your OpenRouter credit.
AUTH_DISABLED=false
AUTH_CACHE_SECONDS=60
RATE_LIMIT_PER_MINUTE=10

# --- LLM ---
# openrouter (any model OpenRouter lists) or openai (OpenAI directly).
LLM_PROVIDER=openrouter
# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any id from https://openrouter.ai/models, e.g. anthropic/claude-sonnet-5.5 or openai/gpt-4o.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: this app's site, shown with its usage in the OpenRouter dashboard.
OPENROUTER_APP_URL=https://dev.mindspear.app
# Only read when LLM_PROVIDER=openai. OPENAI_BASE_URL: an OpenAI-compatible endpoint (Azure, a proxy).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=90
# OpenRouter: each retry is a ~150 s backoff window, not one more attempt.
LLM_MAX_RETRIES=1
# Room for the longest answer; a cut-off answer is broken JSON and yields nothing.
LLM_MAX_TOKENS=16000
# function_calling (tool use; works with every model that has tools) or json_schema
# (response_format; needs structured-output support). json_mode: OpenAI only.
LLM_STRUCTURED_METHOD=function_calling
# Strict structured outputs (OpenAI; the schema must stay strict-compatible).
LLM_STRICT_SCHEMA=false

# --- Generation ---
# Calls made before giving up when the model returns nothing usable.
GENERATION_MAX_ATTEMPTS=2
# Extra calls to fill the gap when fewer items than requested are usable (0 = off).
GENERATION_MAX_TOPUPS=1
MAX_QUESTIONS=30
MAX_TEXT_CHARS=60000
MIN_TEXT_CHARS=40

# --- Tracing (Langfuse) ---
# Both keys set = every /v1/generate request is traced (prompt, answer, tokens, timings).
# Traces include the selected document text, so use a project that may keep it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

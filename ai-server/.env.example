# --- Server ---
APP_ENV=development
LOG_LEVEL=info
# Browser origins allowed to call this server (comma-separated). Not needed when the
# frontend proxies /ai-api to this server (AI_PROXY_URL in the frontend).
CORS_ORIGINS=http://localhost:2000

# --- Sign-in check (the Laravel API; the user's bearer token is verified against it) ---
LARAVEL_API_URL=http://localhost:8000/api/v1
# Local development only: skip the token check entirely.
AUTH_DISABLED=false
AUTH_CACHE_SECONDS=60
RATE_LIMIT_PER_MINUTE=10

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional: an OpenAI-compatible endpoint (Azure, a proxy, a local server).
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=90
# json_schema (response_format with the target's schema), json_mode or function_calling.
LLM_STRUCTURED_METHOD=json_schema
# OpenAI strict structured outputs (schema must stay strict-compatible).
LLM_STRICT_SCHEMA=false

# --- Generation ---
# Calls made before giving up when the model returns nothing usable.
GENERATION_MAX_ATTEMPTS=2
# Extra calls to fill the gap when fewer items than requested are usable (0 = off).
GENERATION_MAX_TOPUPS=1
MAX_QUESTIONS=30
MAX_TEXT_CHARS=60000
MIN_TEXT_CHARS=40

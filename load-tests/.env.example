# Settings for load-tests/run.sh. Copy it:
#
#   cp load-tests/.env.example load-tests/.env    # git-ignored: never commit it
#   chmod 600 load-tests/.env
#
# Any of these can also be given on the command line: PARTICIPANTS=100 load-tests/run.sh ...

# Where the app is. Dev (default): the local stack. A server: its public address.
BASE_URL=http://127.0.0.1:8000
AI_URL=http://127.0.0.1:8001
# Reverb, the live connection (live/ tests). The key is public: the frontend ships it.
# Local stack: REVERB_APP_KEY in backend/.env.docker.
REVERB_URL=ws://127.0.0.1:8080
REVERB_KEY=
# For dev.mindspear.app use .env.server.example instead.

# An account made for load tests, with a verified email (api/ and live/ tests sign in with it).
# Never a real person's account.
K6_USER_EMAIL=
K6_USER_PASSWORD=

# Where k6 sends its results: the monitoring stack's Prometheus (monitoring/README.md).
PROM_WRITE_URL=http://127.0.0.1:9090/api/v1/write

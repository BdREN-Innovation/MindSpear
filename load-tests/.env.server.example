# Settings for load-testing the deployed site, https://dev.mindspear.app. Copy it:
#
#   cp load-tests/.env.server.example load-tests/.env.server   # git-ignored: never commit it
#   chmod 600 load-tests/.env.server
#   ENV_FILE=.env.server PARTICIPANTS=300 load-tests/run.sh live/quiz-session.js
#
# Tell the people using the site before a large run: it is a real server.

BASE_URL=https://dev.mindspear.app
AI_URL=https://dev.mindspear.app/ai-api

# Reverb through the site's nginx (wss://dev.mindspear.app/app/<key>). The key is public: it is
# NEXT_PUBLIC_REVERB_APP_KEY in docker-compose.prod.yml, and must equal REVERB_APP_KEY in
# backend/.env.prod on the server.
REVERB_URL=wss://dev.mindspear.app
REVERB_KEY=30c628dbab604ec2cfaa43f4018cde23

# An account ON THE SERVER made for load tests (verified email), never a real person's.
K6_USER_EMAIL=
K6_USER_PASSWORD=

# k6 runs on this machine and sends its results to the SERVER's Prometheus through an SSH tunnel,
# so they sit next to the server's own CPU, memory and database numbers in its Grafana
# (https://dev.mindspear.app/grafana/). Open the tunnel first, in another terminal:
#
#   ssh -N -L 19090:127.0.0.1:9090 user@server_ip
#
# Local port 19090, because this machine's own monitoring already uses 9090.
PROM_WRITE_URL=http://127.0.0.1:19090/api/v1/write
